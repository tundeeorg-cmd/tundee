# TunDee — environment variables
# Copy this file to .env.local and fill in your values.
# Never commit .env.local — it is listed in .gitignore.

# ── Supabase ─────────────────────────────────────────────────────────────────
# Get these from: Supabase Dashboard → Project Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGci...

# Server-only — used for admin writes and the immutable baseline snapshot API.
# Never expose this in client-side code or commit it to the repo.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...

# ── Admin ─────────────────────────────────────────────────────────────────────
# Email address of the admin user (must match a Supabase auth user).
# The admin dashboard and import API check this value server-side.
NEXT_PUBLIC_ADMIN_EMAIL=your@email.com

# ── Analytics (optional) ─────────────────────────────────────────────────────
# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX).
# If unset, GA is disabled and no tracking script is loaded.
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# ── Meta Pixel & Conversions API ─────────────────────────────────────────────
# Pixel/dataset ID from Events Manager → TunDee Website.
# NEXT_PUBLIC_FB_PIXEL_ID is canonical; NEXT_PUBLIC_META_PIXEL_ID is the older
# name and still works as a fallback. Set ONE of them — setting both is fine
# (FB wins), but they must be the same ID.
#
# There is no hardcoded default on purpose: an unset ID means no pixel loads,
# which is what keeps preview deployments and local dev out of the live dataset.
# Set this in Vercel for PRODUCTION ONLY.
NEXT_PUBLIC_FB_PIXEL_ID=28939107965678201

# Second Meta pixel, owned by the ad agency. Fires ALONGSIDE the primary one —
# both are init'd and every event reaches both datasets. Leave unset to run the
# primary pixel alone; setting it to the same value as the primary is ignored
# (duplicate ids are de-duplicated, since initialising one twice would make Meta
# count every event twice).
#
# NOTE: /api/meta/capi mirrors conversions to the PRIMARY pixel only, so the
# agency dataset receives browser events but not server-side ones.
NEXT_PUBLIC_FB_PIXEL_ID_AGENCY=518364469095414
NEXT_PUBLIC_META_PIXEL_ID=

# Conversions API token — server-side secret, NEVER expose to the browser.
# Events Manager → TunDee Website → Settings → Conversions API →
#   "Set up without Dataset Quality API" → Generate access token.
# Leave BLANK for now: /api/meta/capi returns 204 and does nothing until this is
# set, so the browser pixel works on its own and CAPI activates with no code
# change the moment you add the token.
META_CAPI_ACCESS_TOKEN=

# CAPI token ของเอเจนซี — คู่กับ NEXT_PUBLIC_FB_PIXEL_ID_AGENCY
# token หนึ่งตัวใช้ได้กับ dataset เดียวเท่านั้น จึงต้องตั้งเป็นคู่:
# มี pixel id แต่ไม่มี token = dataset นั้นได้เฉพาะ browser event
# มี token แต่ไม่มี pixel id = ข้ามไปเลย (ไม่ยืม pixel ของอีกตัวมาใช้)
META_CAPI_ACCESS_TOKEN_AGENCY=

# Optional. Events Manager → Test Events → copy the TESTxxxxx code. When set,
# CAPI events are tagged so they show up in the Test Events tab instead of
# counting as live conversions. REMOVE IT once QA is done.
META_TEST_EVENT_CODE=

# ใช้เมื่อ dataset ของเอเจนซีมี test event code คนละตัว
# ถ้าไม่ตั้ง จะใช้ META_TEST_EVENT_CODE ร่วมกันทั้งสอง dataset
META_TEST_EVENT_CODE_AGENCY=

# Optional, local QA only. Set to 1 to load the pixel outside production so you
# can verify with the Meta Pixel Helper against Test Events. Never set in Vercel.
NEXT_PUBLIC_META_PIXEL_DEBUG=

# TikTok Pixel ID. If unset, the TikTok pixel is not loaded.
# TikTok Pixel. Dormant while unset — the base script never loads and every
# lib/analytics call is a harmless no-op. Add the ID once the pixel exists in
# TikTok Ads Manager (Assets → Events → Web Events) and it starts reporting on
# the next deploy, with no code change.
NEXT_PUBLIC_TIKTOK_PIXEL_ID=

# ── Email / Resend (optional) ─────────────────────────────────────────────────
# API key for deadline reminder emails sent via Resend (resend.com).
# Required only if you want the reminder cron to work.
RESEND_API_KEY=re_...

# ── Site URL ─────────────────────────────────────────────────────────────────
# Canonical production URL — used for general links (not the LINE
# redirect_uri; see LINE_REDIRECT_URI below).
NEXT_PUBLIC_SITE_URL=https://www.tundee.org

# ── LINE Messaging API (bot / webhook / push) ──────────────────────────────────
# Get these from: LINE Developers Console → your Messaging API channel
# LINE_CHANNEL_ACCESS_TOKEN – long-lived channel access token, used to push/reply
# LINE_CHANNEL_SECRET       – used to verify the x-line-signature webhook header
LINE_CHANNEL_ACCESS_TOKEN=...
LINE_CHANNEL_SECRET=...

# ── Google Login (one-tap signup) ─────────────────────────────────────────────
# NOTE: Google OAuth is handled BY SUPABASE, not by this app — there is nothing
# to set here. Configure it in:
#   Supabase Dashboard → Authentication → Providers → Google
# and paste the client ID/secret from Google Cloud Console → APIs & Services →
# Credentials → OAuth 2.0 Client ID (Web application).
#
# Authorized redirect URI to whitelist in the GOOGLE CLOUD CONSOLE:
#   https://<your-project-ref>.supabase.co/auth/v1/callback
# (Google talks to Supabase, never directly to tundee.org.)
#
# Then in Supabase → Authentication → URL Configuration:
#   Site URL:       https://www.tundee.org
#   Redirect URLs:  https://www.tundee.org/auth/callback
#                   http://localhost:3000/auth/callback

# ── LINE Login (Connect LINE / account linking + one-tap login) ────────────────
# Get these from: LINE Developers Console → your LINE Login channel.
# The SAME channel powers both bot account-linking and one-tap login — only the
# callback URLs differ (see LINE_REDIRECT_URI and LINE_AUTH_REDIRECT_URI below).
LINE_LOGIN_CHANNEL_ID=...
LINE_LOGIN_CHANNEL_SECRET=...

# Exact redirect_uri registered in LINE Developers Console → LINE Login
# channel → Callback URL. Must be byte-identical between the authorize
# request and the token exchange — this is that single source of truth.
# Falls back to http://localhost:3000/api/line/callback in local dev only.
LINE_REDIRECT_URI=https://www.tundee.org/api/line/callback

# Callback for one-tap LINE *login* (creating/reusing a TunDee account from a
# LINE identity) — a DIFFERENT route from LINE_REDIRECT_URI above, so it must be
# registered as a second Callback URL on the same LINE Login channel.
# Register BOTH of these in LINE Developers Console → LINE Login → Callback URL:
#   https://www.tundee.org/api/auth/line/callback
#   http://localhost:3000/api/auth/line/callback
# Falls back to the localhost value in local dev only.
#
# NOTE: the login flow requests the `email` scope, but LINE only returns an email
# once the channel's "Email address permission" is approved (LINE Developers
# Console → your Login channel → OpenID Connect → Email address permission →
# Apply, which requires uploading a screenshot of the consent screen). Until it
# is approved, LINE accounts are created with a non-deliverable placeholder
# address (line_<userId>@line.tundee.invalid) and log in via LINE only.
LINE_AUTH_REDIRECT_URI=https://www.tundee.org/api/auth/line/callback

# LINE's "add as friend" prompt style during login: normal | aggressive.
# aggressive only does anything if this Login channel has a Linked OA —
# leave unset for normal.
LINE_BOT_PROMPT=

# ── Cron auth ────────────────────────────────────────────────────────────────
# Shared secret checked against the `Authorization: Bearer <CRON_SECRET>`
# header on every /api/cron/* route. Vercel Cron Jobs attach this header
# automatically when CRON_SECRET is set as a project env var.
CRON_SECRET=...

# ── LINE reminder / outcome-followup tuning (optional) ─────────────────────────
# Days before deadline_date to send a deadline reminder (default "14,1").
REMINDER_OFFSETS=14,1
# Days after deadline_date to ask whether the student won the scholarship
# (default "30,60,90"; capped at 3 attempts).
OUTCOME_OFFSETS=30,60,90
# Optional one-line note appended to the outcome-followup question, e.g. a
# thank-you or small incentive, to lift response rate. Leave unset to omit.
OUTCOME_FOLLOWUP_INCENTIVE_NOTE=

# ── LINE outcome survey (v14) ────────────────────────────────────────────────
# SURVEY_REASK_DAYS – days to wait before re-asking a student who answered
# "ยังรอผลอยู่" (waiting). Default 30.
SURVEY_REASK_DAYS=30
# SURVEY_MAX_PER_USER_PER_DAY – rate limit: max survey pushes per user per cron
# run. Default 1. Raise only if you are sure it won't feel like spam.
SURVEY_MAX_PER_USER_PER_DAY=1

# ── Research: randomization salt ─────────────────────────────────────────────
# Keys the HMAC that assigns each user to a ranking arm:
#   arm = HMAC-SHA256(RANDOMIZATION_SALT, user_id | stratum)
#
# Generate once, with: openssl rand -hex 32
#
# SET IT ONCE AND NEVER CHANGE IT. The assignment is deterministic, so a new
# salt silently re-randomizes every already-assigned user and destroys the
# correspondence between the arm recorded on their data and the ranking they
# were actually shown. See research/PREREGISTRATION.md §4.
#
# Must be byte-identical here and in Vercel. Server-only — never expose it to
# the browser, and never prefix it with NEXT_PUBLIC_: anyone holding the salt
# can compute every user's arm.
#
# If it is unset, /api/experiment/assign returns 503 and NOBODY is randomized.
# Signup still works, so the failure is invisible to students — check the logs.
RANDOMIZATION_SALT=
