# local Node.js binary (installed for development only)
/.node

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files — NEVER commit these
#
# Deny everything, then allow back the two templates by name. The previous list
# named five files explicitly, which meant .env.production, .env.staging,
# .env.test and .env.backup were NOT ignored — a file called .env.production
# would have been committed with real credentials and nothing would have warned
# anyone. An allow-list fails closed: a new .env.<anything> is ignored by
# default, and adding a template is a deliberate two-line change.
.env*
!.env.example
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local tool config
.claude/

# staging / scratch data (not for source control)
*.jsonl
scholarships_gaps.md
*_LATEST_*.xlsx
*_LATEST_*.csv
hidden_verified_scholarships.csv
hidden_worklist.csv
